// Paste this whole file into Power BI Desktop > DAX query view, then click
// 'Update model: Add new measures' above DEFINE. Needs a table named _Measures first.
// Generated from measures.dax (same formulas).
DEFINE
    MEASURE '_Measures'[Month-End AUM] =
        // Semi-additive: value on the last month in the current filter context, never a sum over months
        CALCULATE (
            SUM ( 'AUM Monthly'[month_end_aum_cad] ),
            LASTNONBLANK ( 'Date'[date_key], CALCULATE ( SUM ( 'AUM Monthly'[month_end_aum_cad] ) ) )
        )                                                                  // $#,0
    MEASURE '_Measures'[Beginning AUM] =
        CALCULATE (
            SUM ( 'AUM Monthly'[begin_aum_cad] ),
            FIRSTNONBLANK ( 'Date'[date_key], CALCULATE ( SUM ( 'AUM Monthly'[begin_aum_cad] ) ) )
        )                                                                  // $#,0
    MEASURE '_Measures'[Average AUM] =
        DIVIDE (
            SUMX ( 'AUM Monthly', ( 'AUM Monthly'[begin_aum_cad] + 'AUM Monthly'[month_end_aum_cad] ) / 2 ),
            DISTINCTCOUNT ( 'AUM Monthly'[month] )
        )                                                                  // $#,0
    MEASURE '_Measures'[Net New Assets] =
        SUM ( 'AUM Monthly'[net_new_assets_cad] )         // $#,0
    MEASURE '_Measures'[Gross Inflows] =
        SUM ( 'AUM Monthly'[gross_inflows_cad] )           // $#,0
    MEASURE '_Measures'[Gross Outflows] =
        SUM ( 'AUM Monthly'[gross_outflows_cad] )         // $#,0
    MEASURE '_Measures'[Market Movement] =
        SUM ( 'AUM Monthly'[market_movement_cad] )       // $#,0
    MEASURE '_Measures'[Organic Growth Rate (Annualized)] =
        DIVIDE ( [Net New Assets] * 12, SUM ( 'AUM Monthly'[begin_aum_cad] ) )   // 0.0%
    MEASURE '_Measures'[NNA FYTD] =
        // Fiscal year ends 31 October (FY2026 = Nov 2025 - Oct 2026)
        TOTALYTD ( [Net New Assets], 'Date'[date_key], "10/31" )          // $#,0
    MEASURE '_Measures'[NNA Prior FYTD] =
        CALCULATE ( [NNA FYTD], SAMEPERIODLASTYEAR ( 'Date'[date_key] ) )   // $#,0
    MEASURE '_Measures'[NNA vs Prior FYTD] =
        [NNA FYTD] - [NNA Prior FYTD]                  // +$#,0;-$#,0
    MEASURE '_Measures'[AUM Bridge Check] =
        // Should always be 0: begin + NNA + market - end (for a single month)
        [Beginning AUM] + [Net New Assets] + [Market Movement] - [Month-End AUM]
    MEASURE '_Measures'[Fee Revenue] =
        SUM ( 'AUM Monthly'[fee_revenue_cad] )               // $#,0
    MEASURE '_Measures'[Commission Revenue] =
        SUM ( 'AUM Monthly'[commission_revenue_cad] ) // $#,0
    MEASURE '_Measures'[Total Revenue] =
        SUM ( 'AUM Monthly'[total_revenue_cad] )           // $#,0
    MEASURE '_Measures'[Return on Assets (bps)] =
        DIVIDE (
            [Total Revenue] * 12 * 10000,
            SUMX ( 'AUM Monthly', ( 'AUM Monthly'[begin_aum_cad] + 'AUM Monthly'[month_end_aum_cad] ) / 2 )
        )                                                                  // 0.0
    MEASURE '_Measures'[Household Months] =
        COUNTROWS ( 'Client Experience' )
    MEASURE '_Measures'[Active Households] =
        CALCULATE (
            DISTINCTCOUNT ( 'Client Experience'[household_id] ),
            LASTNONBLANK ( 'Date'[date_key], CALCULATE ( COUNTROWS ( 'Client Experience' ) ) ),
            'Client Experience'[month_end_aum_cad] > 0
        )                                                                  // #,0
    MEASURE '_Measures'[Meeting Coverage %] =
        DIVIDE ( COUNTROWS ( FILTER ( 'Client Experience', 'Client Experience'[meetings] > 0 ) ), [Household Months] )  // 0.0%
    MEASURE '_Measures'[Digital Adoption %] =
        DIVIDE ( SUM ( 'Client Experience'[digital_active_flag] ), [Household Months] )   // 0.0%
    MEASURE '_Measures'[Complaints per 100 Households (Monthly)] =
        DIVIDE ( SUM ( 'Client Experience'[complaints] ) * 100, [Household Months] )      // 0.00
    MEASURE '_Measures'[NPS Responses] =
        SUM ( 'Client Experience'[nps_responses] )          // #,0
    MEASURE '_Measures'[NPS] =
        DIVIDE (
            ( SUM ( 'Client Experience'[promoters] ) - SUM ( 'Client Experience'[detractors] ) ) * 100,
            [NPS Responses]
        )                                                                  // 0
    MEASURE '_Measures'[NPS Reliability] =
        IF ( [NPS Responses] < 30, "Directional (< 30 responses)", "Reliable" )
    MEASURE '_Measures'[Attrition Rate (Annualized)] =
        DIVIDE ( SUM ( 'Client Experience'[attrition_flag] ) * 12, [Household Months] )   // 0.0%
    MEASURE '_Measures'[SLA Breach Rate] =
        DIVIDE ( SUM ( 'Service Quality'[sla_breaches] ), SUM ( 'Service Quality'[cases_closed] ) )   // 0.0%
    MEASURE '_Measures'[Average Resolution Hours] =
        DIVIDE (
            SUMX ( 'Service Quality', 'Service Quality'[avg_resolution_hours] * 'Service Quality'[cases_closed] ),
            SUM ( 'Service Quality'[cases_closed] )
        )                                                                  // 0.0
    MEASURE '_Measures'[Incremental per Household] =
        // One campaign + one metric selected: the difference-in-differences estimate
        IF ( HASONEVALUE ( 'Campaign Impact'[metric] ), SUM ( 'Campaign Impact'[did_estimate] ) )
    MEASURE '_Measures'[Impact 95% CI] =
        IF (
            HASONEVALUE ( 'Campaign Impact'[metric] ),
            FORMAT ( SUM ( 'Campaign Impact'[ci_low] ), "#,0.00" ) & " to " & FORMAT ( SUM ( 'Campaign Impact'[ci_high] ), "#,0.00" )
        )
    MEASURE '_Measures'[Impact Verdict] =
        SELECTEDVALUE ( 'Campaign Impact'[verdict] )
    MEASURE '_Measures'[Failed Checks] =
        CALCULATE ( COUNTROWS ( 'Platform Health' ), 'Platform Health'[status] = "FAIL" )
    MEASURE '_Measures'[Critical Failures] =
        CALCULATE ( COUNTROWS ( 'Platform Health' ), 'Platform Health'[status] = "FAIL", 'Platform Health'[severity] = "CRITICAL" )
    MEASURE '_Measures'[Data As Of] =
        FORMAT ( MAX ( 'AUM Daily'[as_of_date] ), "dd mmm yyyy" )

EVALUATE
    ROW (
        "Month-End AUM", [Month-End AUM],
        "Net New Assets", [Net New Assets],
        "Total Revenue", [Total Revenue],
        "AUM Bridge Check", [AUM Bridge Check],
        "Critical Failures", [Critical Failures],
        "Data As Of", [Data As Of]
    )
